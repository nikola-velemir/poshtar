<?xml version="1.0" encoding="utf-8"?>
<gaphor xmlns="https://gaphor.org/model" xmlns:Core="https://gaphor.org/modelinglanguage/Core" xmlns:UML="https://gaphor.org/modelinglanguage/UML" version="4" gaphor-version="3.3.2">
<model>
<Core:StyleSheet id="58d6989a-66f8-11ec-b4c8-0456e5e540ed">
<styleSheet>
<val>diagram {
  font-size: 18px;
}

controlflow {
  dash-style: 0;
  color: black;
}

association,
dependency,
realization,
generalization {
  color: black;
}

*[owner.name="Adapter"] {
  background-color: #F56C51;
  color: white;
  text-color: #272727;
}

*[owner.name="Adapter"] &gt; operation {
  background-color: #F56C51;
  text-color: #272727;
}

*[owner.name="Adapter"] &gt; attribute {
  background-color: #b8e0f7;
  text-color: #272727;
}

*[owner.name="Adapter.Spring"] {
  background-color: #3b8132;
  color: white;
  text-color: #272727;
}

*[owner.name="Adapter.Spring"] &gt; operation {
  background-color: #a8d8ea;
  text-color: #272727;
}

*[owner.name="Adapter.Spring"] &gt; attribute {
  background-color: #b8e0f7;
  text-color: #272727;
}

*[owner.name="Core"] {
  background-color: #6ca7c4;
  color: black;
  text-color: #272727;
}

/* Color the operations compartment */
*[owner.name="Core"] &gt; operation {
  background-color: #a8d8ea;
  text-color: #272727;
}

/* Color the attributes compartment */
*[owner.name="Core"] &gt; attribute {
  background-color: #b8e0f7;
  text-color: #272727;
}

*[owner.name="Adapter.Guice"] {
  background-color: #4285f4;
  color: white;
  text-color: #272727;
}

/* Color the operations compartment */
*[owner.name="Adapter.Guice"] &gt; operation {
  background-color: #a8d8ea;
  text-color: #272727;
}

/* Color the attributes compartment */
*[owner.name="Adapter.Guice"] &gt; attribute {
  background-color: #b8e0f7;
  text-color: #272727;
}

/* Adapter.Quarkus.Deployment - Light Orange */
*[owner.name="Adapter.Quarkus.Deployment"] {
  background-color: #ffb74d;
  color: white;
  text-color: #272727;
}

*[owner.name="Adapter.Quarkus.Deployment"] &gt; operation {
  background-color: #ffe0b2;
  text-color: #272727;
}

*[owner.name="Adapter.Quarkus.Deployment"] &gt; attribute {
  background-color: #fff3e0;
  text-color: #272727;
}

/* Adapter.Quarkus.Runtime - Darker Orange */
*[owner.name="Adapter.Quarkus.Runtime"] {
  background-color: #e65100;
  color: white;
  text-color: #272727;
}

*[owner.name="Adapter.Quarkus.Runtime"] &gt; operation {
  background-color: #ff8f00;
  text-color: #272727;
}

*[owner.name="Adapter.Quarkus.Runtime"] &gt; attribute {
  background-color: #ffb74d;
  text-color: #272727;
}</val>
</styleSheet>
</Core:StyleSheet>

<?xml version="1.0" encoding="utf-8"?>
<gaphor xmlns="https://gaphor.org/model" xmlns:Core="https://gaphor.org/modelinglanguage/Core" xmlns:UML="https://gaphor.org/modelinglanguage/UML" version="4" gaphor-version="3.2.0">
<model>
<Core:StyleSheet id="58d6989a-66f8-11ec-b4c8-0456e5e540ed">
<styleSheet>
<val>diagram {

}

controlflow {
  dash-style: 0;
}
association,
dependency,
realization,
generalization {
  color: white;
}

*[owner.name="Adapter"] {
  background-color: #F56C51;
  color: white;
  text-color: #272727;
}

*[owner.name="Adapter"] &gt; operation {
  background-color:#F56C51;
  text-color: #272727;
}

*[owner.name="Adapter"] &gt; attribute {
  background-color: #b8e0f7;
  text-color: #272727;
}
*[owner.name="Adapter.Spring"] {
  background-color: #3b8132;
  color: white;
  text-color: #272727;
}

*[owner.name="Adapter.Spring"] &gt; operation {
  background-color: #a8d8ea;
  text-color: #272727;
}

*[owner.name="Adapter.Spring"] &gt; attribute {
  background-color: #b8e0f7;
  text-color: #272727;
}

*[owner.name=Core] {
    background-color: #6ca7c4;
  color: white;
  text-color:#272727;
}

/* Color the operations compartment */
*[owner.name=Core] &gt; operation {
  background-color: #a8d8ea;
  text-color:#272727;
}

/* Color the attributes compartment */
*[owner.name=Core] &gt; attribute {
  background-color: #b8e0f7;
  text-color:#272727;
}


*[owner.name="Adapter.Guice"] {
    background-color: #4285f4;
  color: white;
  text-color:#272727;
}

/* Color the operations compartment */
*[owner.name="Adapter.Guice"] { &gt; operation {
  background-color: #a8d8ea;
  text-color:#272727;
}

/* Color the attributes compartment */
*[owner.name="Adapter.Guice"] { &gt; attribute {
  background-color: #b8e0f7;
  text-color:#272727;
}</val>
</styleSheet>
</Core:StyleSheet>
